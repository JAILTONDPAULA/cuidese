# URL base da API Laravel (sem barra no final). Lida no código com import.meta.env.VITE_API_URL.
# Variáveis VITE_ vão para o build e ficam visíveis no navegador: nunca coloque segredos aqui.
# Para sobrescrever só na sua máquina (ex.: IP para testar no celular), crie um .env.local (ignorado pelo git).
VITE_API_URL=http://localhost:8000/api
